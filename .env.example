# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BINANCE_API_KEY & BINANCE_API_SECRET: 币安合约实盘 API 密钥 (在服务器 .env 文件中配置即可自动对接 fapi.binance.com 实盘下单)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
# BINANCE_USE_TESTNET: 是否使用币安合约测试网 (true 为测试网 https://testnet.binancefuture.com，false 为正式网 https://fapi.binance.com)
BINANCE_USE_TESTNET="false"
# BINANCE_FUTURES_BASE_URL: 可选。自定义 fapi 根地址（走代理/镜像时使用），留空则按 BINANCE_USE_TESTNET 自动选择
BINANCE_FUTURES_BASE_URL=""

# ADMIN_PASSWORD: 量化控制台网页访问密码 (默认: admin123，修改后热重载即刻生效，无需重启)
ADMIN_PASSWORD="admin123"

# ---------------- Telegram 交易通知（也可以在前台「系统设置」里填写，会自动写回本文件） ----------------
# 1) 找 @BotFather 发送 /newbot 创建机器人，拿到 Token（形如 123456789:AAH...）
# 2) 给机器人发一条 /start；个人 Chat ID 可用 @userinfobot 获取，群组/频道为负数（-100...）
TELEGRAM_ENABLED="true"
TELEGRAM_TRADE_ALERTS="true"
TELEGRAM_PROTECTION_ALERTS="true"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# EMERGENCY_WEBHOOK_URL: 可选。额外的熔断告警 Webhook（钉钉/Slack/自建服务）
EMERGENCY_WEBHOOK_URL=""
